# ─────────────────────────────────────────────────────────────────────────────
# Brain server environment. Copy this file to `.env` (same directory) and fill in
# the values you want. `.env` is gitignored — your real keys never get committed.
# The server reads this file from the repo root regardless of where it's launched.
# Everything here is optional; the brain runs fully local with zero config.
# ─────────────────────────────────────────────────────────────────────────────

# ── Free remote model providers (optional) ──────────────────────────────────
# Add either/both keys to let the brain use stronger cloud models *in addition*
# to your local Ollama. Local Ollama stays the default; remote providers show up
# in the runtime picker as selectable options you switch to explicitly.
#
# Important: LOCAL_ONLY stays true. Only these two exact provider hosts are
# allowed to bypass the local-only network gate:
#   - integrate.api.nvidia.com   (NVIDIA NIM)
#   - generativelanguage.googleapis.com   (Google Gemini)
# Any other remote URL is still rejected. Embeddings always stay local (Ollama
# nomic-embed-text, 768-dim) so the vector index is never corrupted by a
# different-dimension remote embedder — remote providers are chat-only.

# NVIDIA NIM — get a free key at https://build.nvidia.com (sign in → "Get API Key")
NVIDIA_API_KEY=

# Google Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY is accepted as an alias for GEMINI_API_KEY.
# GOOGLE_AI_API_KEY=

# Override the default remote chat model per provider (optional).
# NVIDIA model catalog: https://build.nvidia.com/models
# NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
# Gemini models: gemini-2.0-flash (fast/free), gemini-2.0-flash-thinking-exp, etc.
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# Optional: add extra exact hostnames allowed to bypass LOCAL_ONLY, comma-separated.
# Only use this if you know what you're doing — each host here can receive your
# prompts. Subdomains are NOT implied; list every exact host.
# REMOTE_PROVIDER_ALLOWLIST=

# ── Local-first networking (defaults shown) ─────────────────────────────────
# LOCAL_ONLY=true       # refuse any non-loopback/RFC1918 baseUrl except the
#                       # allowlisted provider hosts above. Leave this true.

# ── Core server (defaults shown; override only if you need to) ───────────────
# PORT=8787
# HOST=127.0.0.1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=llama3.2:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# EMBEDDING_DIM=768
# DEFAULT_SCAN_ROOT=C:\Users\you\projects
