{
  "name": "virtual-brain-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server run start",
    "server:smoke": "node scripts/server-smoke.mjs",
    "ask:smoke": "node scripts/ask-smoke.mjs",
    "ws:smoke": "node scripts/smoke-ws.mjs",
    "agent:smoke": "node scripts/agent-smoke.mjs",
    "actions:smoke": "node scripts/actions-smoke.mjs",
    "person:smoke": "node scripts/person-smoke.mjs",
    "models:smoke": "node scripts/models-smoke.mjs",
    "web:smoke": "node scripts/web-ingest-smoke.mjs",
    "websearch:smoke": "node scripts/websearch-smoke.mjs",
    "github:smoke": "node scripts/github-smoke.mjs",
    "deepresearch:smoke": "node scripts/smoke-deepresearch.mjs",
    "dev:worker": "cd worker && .venv\\Scripts\\python main.py",
    "dev:all": "concurrently --names \"vite,server\" --prefix-colors \"cyan,magenta\" \"npm run dev\" \"npm run dev:server\"",
    "dev:full": "concurrently --names \"vite,server,worker\" --prefix-colors \"cyan,magenta,yellow\" \"npm run dev\" \"npm run dev:server\" \"npm run dev:worker\"",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "scan": "node scripts/scan.mjs",
    "verify:canvas": "node scripts/verify-canvas.mjs",
    "test:actions": "node scripts/smoke-actions.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test": "npm run verify:canvas && npm run test:actions && npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:integration:watch": "vitest -c vitest.integration.config.ts",
    "test:ui": "vitest --ui",
    "lint": "eslint src server/src shared scripts server/scripts",
    "lint:fix": "eslint src server/src shared scripts server/scripts --fix",
    "gate:lint": "eslint src server/src shared scripts server/scripts --quiet",
    "gate:frontend": "tsc --noEmit",
    "gate:server": "npm --prefix server run typecheck",
    "gate": "node scripts/gate.mjs",
    "tauri": "tauri",
    "sidecar:build": "node scripts/build-server-sidecar.mjs",
    "sidecar:verify": "node scripts/verify-server-sidecar.mjs",
    "tauri:dev": "npm run sidecar:build && tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "dev:desktop": "concurrently --names \"vite,tauri\" --prefix-colors \"cyan,magenta\" \"npm run dev\" \"npm run tauri:dev\""
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.7",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.7"
  }
}
